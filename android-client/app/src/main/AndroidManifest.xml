<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.TakTak">
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="true" />
        <service
            android:name=".data.push.TaktakMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".widget.TaktakAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_taktak_2x2_info" />
        </receiver>

        <receiver
            android:name=".widget.TaktakAppWidgetProvider4x2"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_taktak_4x2_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetReactionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.taktak.app.widget.ACTION_REACT" />
            </intent-filter>
        </receiver>
        <activity android:name=".ui.auth.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.LoginReference" />
        <activity android:name=".ui.theme.ThemeSettingsActivity" android:exported="false"
            android:theme="@style/Theme.TakTak.Chooser" />
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.Premium" />
        <activity android:name=".ui.auth.ForgotPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.Premium" />
        <activity android:name=".ui.auth.EmailVerificationActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.Premium" />
        <activity android:name=".ui.auth.ChangePasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.Premium" />
        <activity android:name=".ui.camera.PreviewActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.M3.Camera" />
        <activity android:name=".ui.history.MomentViewerActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TakTak.M3" />
        <activity android:name=".ui.chat.ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.chat.NewChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.qr.QrScanActivity" android:exported="false"
            android:theme="@style/Theme.TakTak.M3.Camera" />
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.TakTak.Starting"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
