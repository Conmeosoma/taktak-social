<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/taktak_radius_btn" />
                    <solid android:color="#4D808080" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/taktak_radius_btn" />
                    <gradient
                        android:angle="135"
                        android:endColor="@color/taktak_brand_gradient_end"
                        android:startColor="@color/taktak_brand_gradient_start"
                        android:type="linear" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
