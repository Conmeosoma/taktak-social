<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1AFFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/taktak_radius_btn" />
                    <solid android:color="#20808080" />
                    <stroke android:width="1dp" android:color="#30808080" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/taktak_radius_btn" />
                    <solid android:color="?attr/taktakColorSurface" />
                    <stroke android:width="1dp" android:color="?attr/taktakColorBorder" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
