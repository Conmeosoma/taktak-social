<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/taktak_radius_input" />
            <solid android:color="?attr/taktakColorInputBackground" />
            <stroke android:width="2dp" android:color="?attr/taktakColorBorderFocused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/taktak_radius_input" />
            <solid android:color="?attr/taktakColorInputBackground" />
            <stroke android:width="1dp" android:color="?attr/taktakColorBorder" />
        </shape>
    </item>
</selector>
