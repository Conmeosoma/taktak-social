<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Dark mode. -->
    <style name="Base.Theme.TakTak" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>

        <!-- Taktak Design System Semantic Tokens (Default Dark) -->
        <item name="taktakColorBackground">@color/taktak_orig_dark_bg</item>
        <item name="taktakColorSurface">@color/taktak_orig_dark_surface</item>
        <item name="taktakColorSurfaceVariant">@color/taktak_orig_dark_surface_variant</item>
        <item name="taktakColorBrandPrimary">@color/taktak_orig_dark_primary</item>
        <item name="taktakColorBrandSecondary">@color/taktak_orig_dark_secondary</item>
        <item name="taktakColorBrandGradientStart">@color/taktak_brand_gradient_start</item>
        <item name="taktakColorBrandGradientEnd">@color/taktak_brand_gradient_end</item>
        <item name="taktakColorTextPrimary">@color/taktak_orig_dark_text_primary</item>
        <item name="taktakColorTextSecondary">@color/taktak_orig_dark_text_secondary</item>
        <item name="taktakColorTextMuted">@color/taktak_orig_dark_text_muted</item>
        <item name="taktakColorBorder">@color/taktak_orig_dark_border</item>
        <item name="taktakColorBorderFocused">@color/taktak_orig_dark_primary</item>
        <item name="taktakColorBorderError">@color/taktak_status_error</item>
        <item name="taktakColorCardBackground">@color/taktak_orig_dark_surface</item>
        <item name="taktakColorCardBorder">@color/taktak_orig_dark_border</item>
        <item name="taktakColorInputBackground">@color/taktak_orig_dark_surface</item>
        <item name="taktakColorInputText">@color/taktak_orig_dark_text_primary</item>
        <item name="taktakColorInputHint">@color/taktak_orig_dark_text_muted</item>
        <item name="taktakColorNavBackground">@color/taktak_orig_dark_surface</item>
        <item name="taktakColorNavIndicator">#2E253E</item>
        <item name="taktakColorNavActive">@color/taktak_orig_dark_primary</item>
        <item name="taktakColorNavInactive">@color/taktak_orig_dark_text_muted</item>
        <item name="taktakColorShutterRing">#FFFFFF</item>
        <item name="taktakColorShutterCenter">@color/taktak_orig_dark_primary</item>
    </style>
</resources>