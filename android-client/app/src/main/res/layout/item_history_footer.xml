<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/m3_space_16">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/historyMoreButton"
        style="?attr/ttMediaTonalStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minHeight="@dimen/m3_button_height"
        android:text="@string/history_more" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/historyMoreProgress"
        style="@style/Widget.Material3Expressive.CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />
</FrameLayout>
