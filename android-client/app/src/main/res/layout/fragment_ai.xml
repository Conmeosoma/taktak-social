<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/ai_bg" android:paddingHorizontal="20dp" android:saveEnabled="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ai_figma_logo" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/ai_title" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ai_text" />
        <com.google.android.material.button.MaterialButton android:id="@+id/aiTheme" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="☼" android:contentDescription="@string/ai_theme" android:padding="0dp" android:minWidth="0dp" android:textColor="@color/ai_text" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/aiBack" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="←" android:contentDescription="@string/ai_back" android:padding="0dp" android:minWidth="0dp" android:textColor="@color/ai_accent" />
        <TextView android:id="@+id/aiSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ai_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ai_text" />
    </LinearLayout>
    <TextView android:id="@+id/aiPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginVertical="12dp" android:padding="12dp" android:background="@drawable/ai_notice" android:text="@string/ai_privacy" android:textSize="14sp" android:textColor="@color/ai_secondary" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/aiProgress" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="invisible" app:indicatorColor="@color/ai_accent" />
    <TextView android:id="@+id/aiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textSize="14sp" android:textColor="@color/ai_accent" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <LinearLayout android:id="@+id/aiActions" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton android:id="@+id/aiRetry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ai_retry" android:textColor="@color/ai_accent" />
        <com.google.android.material.button.MaterialButton android:id="@+id/aiEdit" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ai_edit" android:textColor="@color/ai_accent" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/aiList" android:layout_width="match_parent" android:layout_height="match_parent" android:saveEnabled="false" android:clipToPadding="false" android:paddingVertical="12dp" />
        <androidx.core.widget.NestedScrollView android:id="@+id/aiEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="24dp">
                <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ai_figma_logo" android:importantForAccessibility="no" android:contentDescription="@null" />
                <TextView android:id="@+id/aiWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="@string/ai_welcome" android:textColor="@color/ai_text" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/aiDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="@string/ai_empty_detail" android:textColor="@color/ai_secondary" android:textSize="15sp" />
                <LinearLayout android:id="@+id/aiSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/aiCaption" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ai_suggestion_caption" android:textColor="@color/ai_text" app:backgroundTint="@color/ai_surface" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/aiWeekend" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ai_suggestion_weekend" android:textColor="@color/ai_text" app:backgroundTint="@color/ai_surface" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/aiBirthday" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ai_suggestion_birthday" android:textColor="@color/ai_text" app:backgroundTint="@color/ai_surface" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/aiMore" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_more" android:minHeight="48dp" android:textColor="@color/ai_accent" android:visibility="gone" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/aiNew" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/ai_primary" android:text="@string/ai_new" android:textAllCaps="false" android:textColor="@color/ai_onbrand" android:textStyle="bold" android:layout_marginVertical="8dp" />
    <TextView android:id="@+id/aiHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_first" android:textColor="@color/ai_secondary" android:textSize="14sp" android:paddingVertical="12dp" />
    <LinearLayout android:id="@+id/aiComposer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="12dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/aiInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="64dp" android:maxLines="4" android:maxLength="4000" android:inputType="textCapSentences|textMultiLine|textNoSuggestions" android:hint="@string/ai_input" android:saveEnabled="false" android:importantForAutofill="no" android:background="@drawable/ai_card" android:padding="16dp" android:textColor="@color/ai_text" android:textColorHint="@color/ai_secondary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/aiSend" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:padding="0dp" android:text="↑" android:textSize="24sp" android:contentDescription="@string/ai_send" android:textColor="@color/ai_accent" app:backgroundTint="@color/ai_raised" />
    </LinearLayout>
</LinearLayout>
