<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/messageBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" app:cardCornerRadius="22dp" app:strokeWidth="0dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/messageImage" android:layout_width="160dp" android:layout_height="160dp" android:scaleType="centerCrop" android:contentDescription="@string/chat_moment" android:visibility="gone" />
            <TextView android:id="@+id/messageText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="260dp" android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/messageReceipt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" android:paddingHorizontal="8dp" android:paddingTop="4dp" />
</LinearLayout>
