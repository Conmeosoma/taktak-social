<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:id="@+id/authScroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="@dimen/m3_screen_padding">
            <LinearLayout android:id="@+id/registerContent"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintWidth_max="@dimen/m3_form_max_width"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="56dp" android:layout_height="56dp"
                        android:padding="@dimen/m3_space_16" android:background="@drawable/m3_brand_badge"
                        android:src="@drawable/ic_camera_shutter" android:importantForAccessibility="no"
                        android:contentDescription="@null" app:tint="?attr/colorOnPrimaryContainer" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/authBrand"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="@dimen/m3_space_12" android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:fontFamily="sans-serif-medium" android:textSize="24sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/authTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/m3_space_32" android:text="@string/auth_register_title"
                    android:textAppearance="@style/TextAppearance.TakTakM3.Headline" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/m3_space_8" android:text="@string/auth_register_subtitle"
                    android:textAppearance="@style/TextAppearance.TakTakM3.Body" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/registerIdentity"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/m3_space_32" android:text="@string/register_identity_section"
                    android:textAppearance="@style/TextAppearance.TakTakM3.Section" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/displayNameLayout"
                    style="@style/Widget.TakTakM3.Field" android:layout_marginTop="@dimen/m3_space_12"
                    android:hint="@string/auth_display_name" app:startIconDrawable="@drawable/ic_m3_person">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/displayNameInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="@dimen/m3_button_height"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:autofillHints="personName" android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/usernameLayout"
                    style="@style/Widget.TakTakM3.Field" android:layout_marginTop="@dimen/m3_space_16"
                    android:hint="@string/auth_username" app:helperText="@string/auth_username_help"
                    app:startIconDrawable="@drawable/ic_m3_username">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/usernameInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="@dimen/m3_button_height"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:autofillHints="newUsername" android:imeOptions="actionNext"
                        android:inputType="textVisiblePassword" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout"
                    style="@style/Widget.TakTakM3.Field" android:layout_marginTop="@dimen/m3_space_16"
                    android:hint="@string/auth_email" app:startIconDrawable="@drawable/ic_m3_mail">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/emailInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="@dimen/m3_button_height"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:autofillHints="emailAddress" android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/registerSecurity"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/m3_space_24" android:text="@string/register_security_section"
                    android:textAppearance="@style/TextAppearance.TakTakM3.Section" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout"
                    style="@style/Widget.TakTakM3.Field" android:layout_marginTop="@dimen/m3_space_12"
                    android:hint="@string/auth_password" app:helperText="@string/auth_password_help"
                    app:startIconDrawable="@drawable/ic_m3_lock" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="@dimen/m3_button_height"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:autofillHints="newPassword" android:imeOptions="actionNext|flagNoPersonalizedLearning"
                        android:inputType="textPassword" android:saveEnabled="false" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmPasswordLayout"
                    style="@style/Widget.TakTakM3.Field" android:layout_marginTop="@dimen/m3_space_16"
                    android:hint="@string/auth_confirm_password" app:startIconDrawable="@drawable/ic_m3_lock"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="@dimen/m3_button_height"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:autofillHints="newPassword" android:imeOptions="actionDone|flagNoPersonalizedLearning"
                        android:inputType="textPassword" android:saveEnabled="false" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/m3_space_24">
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/loadingIndicator"
                        style="@style/Widget.Material3Expressive.LinearProgressIndicator"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" android:contentDescription="@string/auth_processing"
                        android:indeterminate="true" android:visibility="gone" />
                </FrameLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/formNotice"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/m3_space_16" android:padding="@dimen/m3_space_16"
                    android:background="@drawable/m3_notice_background"
                    android:textAppearance="@style/TextAppearance.TakTakM3.Body"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:accessibilityLiveRegion="polite" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/submitButton"
                    style="@style/Widget.TakTakM3.Button" android:text="@string/auth_register" />
                <com.google.android.material.button.MaterialButton android:id="@+id/switchButton"
                    style="@style/Widget.TakTakM3.TextButton"
                    android:layout_marginTop="@dimen/m3_space_12" android:text="@string/auth_go_login" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
