<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.taktak.app.ui.auth.AuthBackdropView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/registerSafeContent"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView android:id="@+id/authScroll" android:layout_width="0dp" android:layout_height="0dp"
            android:fillViewport="true" android:clipToPadding="false" app:layout_constraintWidth_max="480dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout android:id="@+id/registerContent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="16dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="84dp">
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/registerBack"
                        android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/login_back"
                        app:tint="?attr/colorOnSurface" android:contentDescription="@string/login_back" />
                    <com.taktak.app.ui.auth.LoginLogoView android:layout_width="64dp" android:layout_height="64dp"
                        android:layout_gravity="center_horizontal|bottom" android:contentDescription="@string/app_name" />
                </FrameLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/authBrand"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:layout_marginTop="8dp" android:text="@string/login_wordmark" android:textSize="24sp"
                    android:fontFamily="sans-serif-rounded" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/authTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/auth_register_title" android:textAppearance="?attr/ttAuthHeadlineStyle" android:textSize="30sp" />
                <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/auth_register_subtitle"
                    android:textAppearance="@style/TextAppearance.TakTakM3.Body" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/registerIdentity"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:text="@string/register_identity_section" android:textAppearance="@style/TextAppearance.TakTakM3.Section" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/displayNameLayout"
                    style="?attr/ttAuthFieldStyle" android:layout_marginTop="10dp"
                    app:hintEnabled="false" app:startIconDrawable="@drawable/ic_m3_person" >
                    <com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/displayNameInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                        android:paddingVertical="14dp" android:textSize="16sp" android:hint="@string/auth_display_name"
                        android:inputType="textPersonName|textCapWords" android:autofillHints="personName" android:imeOptions="actionNext"
                        android:singleLine="true"  />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/usernameLayout"
                    style="?attr/ttAuthFieldStyle" android:layout_marginTop="10dp"
                    app:hintEnabled="false" app:startIconDrawable="@drawable/ic_m3_username" app:helperText="@string/auth_username_help">
                    <com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/usernameInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                        android:paddingVertical="14dp" android:textSize="16sp" android:hint="@string/auth_username"
                        android:inputType="textVisiblePassword" android:autofillHints="newUsername" android:imeOptions="actionNext"
                        android:singleLine="true"  />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout"
                    style="?attr/ttAuthFieldStyle" android:layout_marginTop="10dp"
                    app:hintEnabled="false" app:startIconDrawable="@drawable/ic_m3_mail" >
                    <com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/emailInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                        android:paddingVertical="14dp" android:textSize="16sp" android:hint="@string/auth_email"
                        android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext"
                        android:singleLine="true"  />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/registerSecurity"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:text="@string/register_security_section" android:textAppearance="@style/TextAppearance.TakTakM3.Section" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout"
                    style="?attr/ttAuthFieldStyle" android:layout_marginTop="10dp"
                    app:hintEnabled="false" app:startIconDrawable="@drawable/ic_m3_lock" app:helperText="@string/auth_password_help" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/passwordInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                        android:paddingVertical="14dp" android:textSize="16sp" android:hint="@string/auth_password"
                        android:inputType="textPassword" android:autofillHints="newPassword" android:imeOptions="actionNext|flagNoPersonalizedLearning"
                        android:singleLine="true" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:id="@+id/passwordStrengthContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="6dp"
                    android:visibility="gone">
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/passwordStrengthProgress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:max="100" app:trackCornerRadius="2dp" app:trackThickness="4dp" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/passwordStrengthText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.TakTakM3.Body" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmPasswordLayout"
                    style="?attr/ttAuthFieldStyle" android:layout_marginTop="10dp"
                    app:hintEnabled="false" app:startIconDrawable="@drawable/ic_m3_lock" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                        android:paddingVertical="14dp" android:textSize="16sp" android:hint="@string/auth_confirm_password"
                        android:inputType="textPassword" android:autofillHints="newPassword" android:imeOptions="actionDone|flagNoPersonalizedLearning"
                        android:singleLine="true" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="16dp">
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/loadingIndicator"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
                        android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/auth_processing" />
                </FrameLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/formNotice"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"
                    android:layout_marginBottom="12dp" android:background="?attr/ttAuthNotice"
                    android:textColor="?attr/colorOnSurface" android:accessibilityLiveRegion="polite" android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/submitButton"
                    style="?attr/ttAuthPrimaryStyle" android:text="@string/auth_register" />
                <com.google.android.material.button.MaterialButton android:id="@+id/switchButton"
                    style="@style/Widget.TakTakM3.TextButton" android:layout_marginTop="8dp" android:text="@string/auth_go_login" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
