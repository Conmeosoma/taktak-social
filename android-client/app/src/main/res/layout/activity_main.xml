<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:saveEnabled="false">
    <ScrollView android:id="@+id/cameraScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:saveEnabled="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/bootstrapMessage" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/bootstrap_message"
            android:textAppearance="@style/TextAppearance.TakTak.Camera.Title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="@color/camera_ink"
            android:text="@string/session_logout" android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/sessionProgress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:indeterminate="true" android:contentDescription="@string/session_checking" />
        <TextView android:id="@+id/sessionMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:text="@string/session_checking"
            android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
        <LinearLayout android:id="@+id/cameraPanel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:visibility="gone" android:saveEnabled="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/friendsButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/friends_title" />
            <TextView android:id="@+id/cameraTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:text="@string/camera_title" android:textAppearance="@style/TextAppearance.TakTak.Camera.Title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/camera_subtitle"
                android:textAppearance="@style/TextAppearance.TakTak.Camera.Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/camera_private_badge"
                android:textColor="@color/camera_ink" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
            <androidx.fragment.app.FragmentContainerView android:id="@+id/cameraContent"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/retryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="24dp"
            android:text="@string/session_retry" android:visibility="gone" />
    </LinearLayout>
    </ScrollView>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/friendsContent"
        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>
