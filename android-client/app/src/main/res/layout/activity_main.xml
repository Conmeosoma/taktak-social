<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:saveEnabled="false"
    android:background="?attr/ttMediaBackground">

    <com.taktak.app.ui.theme.MediaBackdropView
        android:id="@+id/premiumBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/mainSafeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Main Toolbar / Header -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mainToolbar"
            style="@style/Widget.Material3Expressive.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@android:color/transparent"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/taktak_space_md">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/bootstrapMessage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/bootstrap_message"
                    android:textColor="?attr/colorSecondary"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    style="@style/Widget.TakTakM3.TextButton"
                    android:layout_width="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/session_logout"
                    android:textColor="?attr/taktakColorTextSecondary"
                    android:visibility="gone"     android:minHeight="@dimen/taktak_touch_target_min" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Theme Pending Notice -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/themeMediaNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/taktak_space_sm"
            android:text="@string/theme_media_pending"
            android:textColor="?attr/taktakColorTextPrimary"
            android:background="?attr/taktakColorSurface"
            android:fontFamily="@font/inter"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <!-- Main Body: Session Checking or Pager Panel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Session Waiting Card -->
            <ScrollView
                android:id="@+id/sessionScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:saveEnabled="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/taktak_space_md">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sessionCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintWidth_max="@dimen/m3_form_max_width"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/taktakColorBorder"
                        app:cardBackgroundColor="?attr/taktakColorSurface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/taktak_space_xl"
                            android:gravity="center_horizontal">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/sessionProgress"
                                style="@style/Widget.Material3Expressive.CircularProgressIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="true"
                                android:contentDescription="@string/session_checking" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/sessionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/taktak_space_md"
                                android:gravity="center"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                android:text="@string/m3_session_waiting"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/sessionMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/taktak_space_xs"
                                android:gravity="center"
                                android:fontFamily="@font/inter"
                                android:text="@string/session_checking"
                                android:textAppearance="@style/TextAppearance.TakTakM3.Body"
                                android:accessibilityLiveRegion="polite"
                                android:saveEnabled="false" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/retryButton"
                                style="@style/Widget.TakTakM3.Button"
                                android:layout_marginTop="@dimen/taktak_space_xl"
                                android:fontFamily="@font/inter"
                                android:text="@string/session_retry"
                                android:visibility="gone"     android:minHeight="@dimen/taktak_touch_target_min" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>

            <!-- 5-Tab Pager Host -->
            <FrameLayout
                android:id="@+id/cameraPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:saveEnabled="false">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/mainPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:saveEnabled="false" />
            </FrameLayout>
        </FrameLayout>

        <!-- Bottom Navigation 5 Tabs (M3 Expressive) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            style="@style/Widget.Material3Expressive.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:saveEnabled="false"
            app:menu="@menu/main_tabs"
            app:labelVisibilityMode="unlabeled"
            app:itemHorizontalTranslationEnabled="false"
            android:layout_marginHorizontal="@dimen/taktak_space_sm"
            android:layout_marginBottom="@dimen/taktak_space_xs"
            android:background="?attr/ttMediaNavBackground"
            app:elevation="0dp"
            app:itemIconSize="26dp"
            app:itemIconTint="?attr/ttMediaNavColors"
            app:itemTextColor="?attr/ttMediaNavColors"
            app:itemActiveIndicatorStyle="?attr/ttMediaIndicatorStyle" />
    </LinearLayout>

    <!-- Biometric Security Overlay -->
    <LinearLayout
        android:id="@+id/biometricLockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/ttMediaBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/taktak_space_xxl"
        android:visibility="gone">

        <ImageView
            android:id="@+id/biometricOverlayIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/biometric_lock_title"
            android:src="@drawable/ic_biometric_fingerprint"
            app:tint="?attr/taktakColorBrandPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_xl"
            android:text="@string/biometric_prompt_title"
            android:textAppearance="@style/TextAppearance.Taktak.PageTitle"
            android:textColor="?attr/taktakColorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_xs"
            android:gravity="center"
            android:text="@string/biometric_locked_hint"
            android:textAppearance="@style/TextAppearance.Taktak.Body"
            android:textColor="?attr/taktakColorTextMuted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/biometricUnlockButton"
            style="@style/Widget.Taktak.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_xxl"
            android:paddingHorizontal="@dimen/taktak_space_xxl"
            android:text="@string/biometric_unlock_button"     android:minHeight="@dimen/taktak_touch_target_min" />
    </LinearLayout>
</FrameLayout>
