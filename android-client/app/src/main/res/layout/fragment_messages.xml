<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp" android:saveEnabled="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/messagesTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/chat_title" android:textAppearance="?attr/ttMediaHeadlineStyle" android:textSize="32sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/messagesNew" style="?attr/ttMediaTonalStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="+" android:contentDescription="@string/chat_new" />
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="?attr/ttMediaFieldStyle" android:hint="@string/chat_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/messagesSearch" style="?attr/ttMediaInputStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/messagesProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:contentDescription="@string/chat_loading" android:visibility="invisible" />
    <TextView android:id="@+id/messagesStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:accessibilityLiveRegion="polite" android:visibility="gone" android:padding="8dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/messagesRefresh" style="?attr/ttMediaTonalStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_refresh" />
    <com.google.android.material.button.MaterialButton android:id="@+id/messagesNotifications" style="?attr/ttMediaTonalStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_enable_notifications" android:visibility="gone" />
    <androidx.core.widget.NestedScrollView android:id="@+id/messagesEmpty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="32dp">
            <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_chat" app:tint="#D46B23" android:importantForAccessibility="no" android:contentDescription="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_empty_title" android:textSize="24sp" android:textColor="?attr/colorOnSurface" android:gravity="center" android:layout_marginTop="24dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_empty_detail" android:textSize="16sp" android:textColor="?attr/colorOnSurfaceVariant" android:gravity="center" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/messagesFindFriends" style="?attr/ttMediaPrimaryStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_find_friends" android:layout_marginTop="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/messagesList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" android:saveEnabled="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/messagesMore" style="?attr/ttMediaTonalStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_more" android:visibility="gone" />
</LinearLayout>
