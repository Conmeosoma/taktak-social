<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp">
    <LinearLayout android:id="@+id/aiBubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="36dp" android:padding="16dp" android:background="@drawable/ai_card" android:gravity="top">
        <ImageView android:id="@+id/aiAvatar" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="8dp" android:src="@drawable/ai_figma_logo" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:id="@+id/aiText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/ai_text" android:textIsSelectable="true" android:saveEnabled="false" />
    </LinearLayout>
