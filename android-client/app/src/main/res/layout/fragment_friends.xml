<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/taktakColorSurface"
    android:saveEnabled="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/friendsAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/taktak_space_md"
                app:layout_scrollFlags="scroll|enterAlways">

                <!-- Top Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/friendsBack"
                        style="@style/Widget.Taktak.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/friends_back"
                        app:icon="@drawable/login_back"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        app:iconTint="?attr/taktakColorBrandPrimary"     android:minHeight="@dimen/taktak_touch_target_min" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/friendsLogout"
                        style="@style/Widget.Taktak.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/session_logout"
                        android:textColor="?attr/taktakColorTextMuted"     android:minHeight="@dimen/taktak_touch_target_min" />
                </LinearLayout>

                <!-- Title & Description -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/friendsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xs"
                    android:text="@string/friends_title"
                    android:textAppearance="@style/TextAppearance.Taktak.LargeTitle"
                    android:textColor="?attr/taktakColorTextPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xxs"
                    android:text="@string/premium_friends_detail"
                    android:textAppearance="@style/TextAppearance.Taktak.Body"
                    android:textColor="?attr/taktakColorTextSecondary" />

                <!-- Search Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/friendsQueryLayout"
                    style="@style/Widget.Taktak.TextInputLayout"
                    android:layout_marginTop="@dimen/taktak_space_md"
                    android:hint="@string/friends_query"
                    app:startIconDrawable="@drawable/ic_m3_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/friendsQuery"
                        style="@style/Widget.Taktak.TextInputEditText"
                        android:hint="@string/friends_query"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="textVisiblePassword"
                        android:maxLength="255"
                        android:saveEnabled="false"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Search & Refresh Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/friendsSearch"
                        style="@style/Widget.Taktak.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/taktak_btn_height_medium"
                        android:minWidth="0dp"
                        android:text="@string/friends_search" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/friendsRefresh"
                        style="@style/Widget.Taktak.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/taktak_space_sm"
                        android:layout_weight="1"
                        android:minHeight="@dimen/taktak_btn_height_medium"
                        android:minWidth="0dp"
                        android:text="@string/friends_refresh" />
                </LinearLayout>

                <!-- QR Code Actions Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xs"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/friendsScanQr"
                        style="@style/Widget.Taktak.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/taktak_btn_height_medium"
                        android:minWidth="0dp"
                        android:text="@string/friends_scan_qr_btn"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/friendsMyQr"
                        style="@style/Widget.Taktak.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/taktak_space_sm"
                        android:layout_weight="1"
                        android:minHeight="@dimen/taktak_btn_height_medium"
                        android:minWidth="0dp"
                        android:text="@string/friends_my_qr_btn"
                        app:icon="@drawable/ic_qr_code"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />
                </LinearLayout>

                <!-- Progress Indicator -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/taktak_space_sm"
                    android:layout_marginTop="@dimen/taktak_space_xs">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/friendsProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/friends_loading"
                        android:indeterminate="true"
                        android:visibility="invisible"
                        app:indicatorColor="?attr/taktakColorBrandPrimary"
                        app:trackColor="?attr/taktakColorBorder" />
                </FrameLayout>

                <!-- Notice Banner -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/friendsMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/taktak_space_xs"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/login_notice"
                    android:padding="@dimen/taktak_space_md"
                    android:saveEnabled="false"
                    android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                    android:textColor="?attr/taktakColorTextPrimary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Friends List Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/friendsRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/taktak_space_md"
            android:paddingTop="@dimen/taktak_space_xs"
            android:paddingBottom="@dimen/taktak_space_xl"
            android:saveEnabled="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
