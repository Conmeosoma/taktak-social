<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/qrCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Viewfinder Overlay with Animated Scanning Line -->
    <com.taktak.app.ui.qr.QrScannerOverlayView
        android:id="@+id/qrOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/taktak_space_md"
        android:paddingEnd="@dimen/taktak_space_md"
        android:paddingTop="@dimen/taktak_space_md"
        android:paddingBottom="@dimen/taktak_space_md">

        <ImageButton
            android:id="@+id/btnQrBack"
            android:layout_width="@dimen/taktak_touch_target_min"
            android:layout_height="@dimen/taktak_touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/login_back"
            app:tint="@android:color/white"
            android:contentDescription="@string/btn_back" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/taktak_space_sm"
            android:text="@string/qr_scan_title"
            android:textAppearance="@style/TextAppearance.Taktak.PageTitle"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnQrFlash"
            android:layout_width="@dimen/taktak_touch_target_min"
            android:layout_height="@dimen/taktak_touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_premium_flash"
            app:tint="@android:color/white"
            android:contentDescription="@string/camera_flash" />
    </LinearLayout>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/taktak_space_lg"
        android:paddingEnd="@dimen/taktak_space_lg"
        android:paddingBottom="@dimen/taktak_space_xl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQrRetry"
            style="@style/Widget.Taktak.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_retry"
            android:visibility="gone"     android:minHeight="@dimen/taktak_touch_target_min" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/qrInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_scan_hint"
            android:textAppearance="@style/TextAppearance.Taktak.Body"
            android:textColor="@color/taktak_fixed_ccffffff"
            android:gravity="center"
            android:layout_marginBottom="@dimen/taktak_space_xl" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Pick from Gallery -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQrPickGallery"
                style="@style/Widget.Taktak.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qr_btn_gallery"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                android:textColor="@android:color/white"
                app:strokeColor="@color/taktak_fixed_55ffffff"
                app:backgroundTint="@color/taktak_fixed_40000000"     android:minHeight="@dimen/taktak_touch_target_min" />

            <View
                android:layout_width="@dimen/taktak_space_md"
                android:layout_height="1dp" />

            <!-- Show My QR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQrShowMyCode"
                style="@style/Widget.Taktak.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qr_btn_my_code"
                app:icon="@drawable/ic_qr_code"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                android:textColor="@android:color/white"
                app:strokeColor="@color/taktak_fixed_55ffffff"
                app:backgroundTint="@color/taktak_fixed_40000000"     android:minHeight="@dimen/taktak_touch_target_min" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
