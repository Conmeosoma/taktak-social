<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/taktakColorSurface"
    android:orientation="vertical"
    android:saveEnabled="false">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/taktak_login_action_min_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/taktak_space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retakeButton"
            style="@style/Widget.Taktak.Button.Ghost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/taktak_btn_height_medium"
            android:text="@string/preview_retake"
            app:icon="@drawable/login_back"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="?attr/taktakColorBrandPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewLogoutButton"
            style="@style/Widget.Taktak.Button.Ghost"
            android:layout_width="wrap_content"
            android:minHeight="@dimen/taktak_btn_height_medium"
            android:minWidth="0dp"
            android:text="@string/session_logout"
            android:textColor="?attr/taktakColorTextMuted"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/previewProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="?attr/taktakColorBrandPrimary"
        app:trackColor="?attr/taktakColorBorder" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/previewNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:padding="@dimen/taktak_space_md"
        android:saveEnabled="false"
        android:text="@string/session_checking"
        android:textAppearance="@style/TextAppearance.Taktak.Body"
        android:textColor="?attr/taktakColorTextSecondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/previewSessionRetry"
        style="@style/Widget.Taktak.Button.Primary"
        android:layout_marginHorizontal="@dimen/taktak_space_md"
        android:text="@string/session_retry"
        android:visibility="gone"     android:minHeight="@dimen/taktak_touch_target_min" />

    <ScrollView
        android:id="@+id/previewScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:saveEnabled="false"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/taktak_space_xl"
            android:paddingBottom="@dimen/taktak_space_xl">

            <LinearLayout
                android:id="@+id/previewContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="480dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/previewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_title"
                    android:textAppearance="@style/TextAppearance.Taktak.LargeTitle"
                    android:textColor="?attr/taktakColorTextPrimary" />

                <!-- Square 1:1 Captured Image Preview -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_md"
                    app:cardBackgroundColor="?attr/taktakColorSurface"
                    app:cardCornerRadius="@dimen/taktak_radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/taktakColorBorder"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/previewImage"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="@string/preview_image"
                            android:saveEnabled="false"
                            android:scaleType="fitCenter"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.taktak.app.ui.camera.DoodleOverlayView
                            android:id="@+id/doodleOverlay"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@id/previewImage"
                            app:layout_constraintEnd_toEndOf="@id/previewImage"
                            app:layout_constraintStart_toStartOf="@id/previewImage"
                            app:layout_constraintTop_toTopOf="@id/previewImage" />

                        <TextView
                            android:id="@+id/previewLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:background="@drawable/login_notice"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/preview_live_badge"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Creative Tools Toolbar -->
                <LinearLayout
                    android:id="@+id/creativeToolsBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_sm"
                    android:orientation="vertical">

                    <!-- Creative Creation Tools (Row 1) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToolDoodle"
                            style="@style/Widget.Taktak.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/taktak_space_xs"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="@dimen/taktak_touch_target_min"
                            android:paddingHorizontal="@dimen/taktak_space_xxs"
                            android:text="@string/tool_doodle"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToolSticker"
                            style="@style/Widget.Taktak.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/taktak_space_xs"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="@dimen/taktak_touch_target_min"
                            android:paddingHorizontal="@dimen/taktak_space_xxs"
                            android:text="@string/tool_sticker"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToolTag"
                            style="@style/Widget.Taktak.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="@dimen/taktak_touch_target_min"
                            android:paddingHorizontal="@dimen/taktak_space_xxs"
                            android:text="@string/tool_tag"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Edit Actions (Row 2) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/taktak_space_xs"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToolUndo"
                            style="@style/Widget.Taktak.Button.Ghost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/taktak_space_xs"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="@dimen/taktak_touch_target_min"
                            android:paddingHorizontal="@dimen/taktak_space_xs"
                            android:text="@string/tool_undo"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToolClear"
                            style="@style/Widget.Taktak.Button.Ghost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="@dimen/taktak_touch_target_min"
                            android:paddingHorizontal="@dimen/taktak_space_xs"
                            android:text="@string/tool_clear"
                            android:textColor="@color/taktak_status_error"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Color Palette (Doodle Mode) -->
                <LinearLayout
                    android:id="@+id/colorPaletteBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/colorWhite"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/taktak_shutter_ring"
                        android:backgroundTint="@color/taktak_color_neutral_white" />

                    <View
                        android:id="@+id/colorYellow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/taktak_shutter_ring"
                        android:backgroundTint="@color/taktak_fixed_ffd600" />

                    <View
                        android:id="@+id/colorCoral"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/taktak_shutter_ring"
                        android:backgroundTint="@color/taktak_fixed_ff3b5c" />

                    <View
                        android:id="@+id/colorMint"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/taktak_shutter_ring"
                        android:backgroundTint="@color/taktak_fixed_00e676" />

                    <View
                        android:id="@+id/colorPurple"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/taktak_shutter_ring"
                        android:backgroundTint="@color/taktak_fixed_7c4dff" />
                </LinearLayout>

                <!-- Emoji Stickers Quick Palette -->
                <HorizontalScrollView
                    android:id="@+id/stickerPaletteBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/stickerEmojiContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/taktak_space_xxs" />
                </HorizontalScrollView>

                <!-- Caption Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/captionLayout"
                    style="@style/Widget.Taktak.TextInputLayout"
                    android:layout_marginTop="@dimen/taktak_space_lg"
                    android:hint="@string/preview_caption">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/captionInput"
                        style="@style/Widget.Taktak.TextInputEditText"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                        android:maxLength="50"
                        android:maxLines="3"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/captionCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xxs"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.Taktak.Caption"
                    android:textColor="?attr/taktakColorTextMuted" />

                <!-- Photo Poll Creation Section -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPoll"
                    style="@style/Widget.Taktak.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_sm"
                    android:text="@string/poll_add"
                    app:icon="@drawable/ic_premium_plus"
                    app:iconGravity="textStart" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pollCreationCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xs"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/taktakColorSurface"
                    app:cardCornerRadius="@dimen/taktak_radius_md"
                    app:strokeColor="?attr/taktakColorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/taktak_space_sm">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Taktak.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/poll_question_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pollQuestionInput"
                                style="@style/Widget.Taktak.TextInputEditText"
                                android:maxLength="100"
                                android:maxLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Taktak.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/taktak_space_xs"
                            android:hint="@string/poll_option_a_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pollOptionAInput"
                                style="@style/Widget.Taktak.TextInputEditText"
                                android:maxLength="40"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Taktak.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/taktak_space_xs"
                            android:hint="@string/poll_option_b_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pollOptionBInput"
                                style="@style/Widget.Taktak.TextInputEditText"
                                android:maxLength="40"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemovePoll"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/taktak_space_xxs"
                            android:text="@string/poll_remove"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recipient Selection Heading -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/recipientHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_lg"
                    android:text="@string/preview_recipients"
                    android:textAppearance="@style/TextAppearance.Taktak.SectionTitle"
                    android:textColor="?attr/taktakColorTextPrimary" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/allFriendsCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/taktak_touch_target_min"
                    android:saveEnabled="false"
                    android:text="@string/preview_all"
                    android:textAppearance="@style/TextAppearance.Taktak.Body"
                    android:textColor="?attr/taktakColorTextPrimary"
                    app:buttonTint="?attr/taktakColorBrandPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/friendsNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                    android:textColor="?attr/taktakColorTextSecondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recipientsList"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:contentDescription="@string/preview_recipients"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/friendsMoreButton"
                    style="@style/Widget.Taktak.Button.Ghost"
                    android:layout_width="match_parent"
                    android:text="@string/preview_more"
                    android:visibility="gone"     android:minHeight="@dimen/taktak_touch_target_min" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_md"
                    android:text="@string/preview_send_hint"
                    android:textAppearance="@style/TextAppearance.Taktak.Caption"
                    android:textColor="?attr/taktakColorTextMuted" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Fixed Bottom Actions Dock -->
    <LinearLayout
        android:id="@+id/previewBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/taktakColorSurface"
        android:paddingHorizontal="@dimen/taktak_space_xl"
        android:paddingTop="@dimen/taktak_space_sm"
        android:paddingBottom="@dimen/taktak_space_md"
        android:visibility="gone">

        <!-- Send to Friends Button (Gradient Primary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendFriendsButton"
            style="@style/Widget.Taktak.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="@dimen/taktak_touch_target_min"
            android:text="@string/preview_send" />

        <!-- Save Private Button (Secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/savePrivateButton"
            style="@style/Widget.Taktak.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_xs"
            android:minHeight="@dimen/taktak_touch_target_min"
            android:text="@string/preview_private" />
    </LinearLayout>
</LinearLayout>
