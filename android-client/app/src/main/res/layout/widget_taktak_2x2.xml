<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Moment Display Container -->
    <FrameLayout
        android:id="@+id/widget_moment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_2x2_name" />

        <ImageView
            android:id="@+id/widget_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_gradient_overlay"
            android:scaleType="fitXY"
            android:contentDescription="@null" android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/taktak_space_sm"
            android:paddingEnd="@dimen/taktak_space_sm"
            android:paddingBottom="@dimen/taktak_space_sm">

            <TextView
                android:id="@+id/widget_sender_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/taktak_color_neutral_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/taktak_fixed_e0e0e0"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Interactive Reaction Bar -->
        <LinearLayout
            android:id="@+id/widget_reaction_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/taktak_space_xs"
            android:layout_marginEnd="@dimen/taktak_space_xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_react_heart"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="@string/ui_glyph_heart"
                android:contentDescription="@string/ui_reaction_heart"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_react_fire"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="@string/ui_glyph_fire"
                android:contentDescription="@string/ui_reaction_fire"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_react_laugh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="@string/ui_glyph_laugh"
                android:contentDescription="@string/ui_reaction_laugh"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Emoji Burst Badge -->
        <TextView
            android:id="@+id/widget_reaction_burst"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="32sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Empty State Placeholder -->
    <LinearLayout
        android:id="@+id/widget_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/taktak_space_md"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_camera"
            android:contentDescription="@string/widget_empty_title" />

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_xs"
            android:gravity="center"
            android:text="@string/widget_empty_title"
            android:textColor="@color/taktak_color_neutral_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/widget_empty_subtitle"
            android:textColor="@color/taktak_fixed_b0b0b0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Logged Out State -->
    <LinearLayout
        android:id="@+id/widget_logged_out_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/taktak_space_md"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_logged_out_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_lock"
            android:contentDescription="@string/widget_logged_out_title" />

        <TextView
            android:id="@+id/widget_logged_out_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_xs"
            android:gravity="center"
            android:text="@string/widget_logged_out_title"
            android:textColor="@color/taktak_color_neutral_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_logged_out_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/widget_logged_out_subtitle"
            android:textColor="@color/taktak_fixed_b0b0b0"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
