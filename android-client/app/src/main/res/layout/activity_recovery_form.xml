<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
 <com.taktak.app.ui.auth.AuthBackdropView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
 <androidx.core.widget.NestedScrollView android:id="@+id/safeContent" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <com.google.android.material.textview.MaterialTextView android:id="@+id/authBrand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="?attr/colorPrimary" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
 <com.google.android.material.textview.MaterialTextView android:id="@+id/authTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" style="?attr/ttAuthHeadlineStyle" />
 <com.google.android.material.textview.MaterialTextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
<com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout" style="?attr/ttAuthFieldStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/auth_email" >
<com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textEmailAddress" android:saveEnabled="false" android:importantForAutofill="no" android:singleLine="true" android:imeOptions="actionNext|flagNoPersonalizedLearning" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/currentLayout" style="?attr/ttAuthFieldStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/recovery_current" app:endIconMode="password_toggle">
<com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/currentInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:saveEnabled="false" android:importantForAutofill="no" android:singleLine="true" android:imeOptions="actionNext|flagNoPersonalizedLearning" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/codeLayout" style="?attr/ttAuthFieldStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/recovery_code" >
<com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/codeInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textVisiblePassword" android:saveEnabled="false" android:importantForAutofill="no" android:singleLine="true" android:imeOptions="actionNext|flagNoPersonalizedLearning" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/newLayout" style="?attr/ttAuthFieldStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/recovery_new" app:endIconMode="password_toggle">
<com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/newInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:saveEnabled="false" android:importantForAutofill="no" android:singleLine="true" android:imeOptions="actionNext|flagNoPersonalizedLearning" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmLayout" style="?attr/ttAuthFieldStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/recovery_confirm" app:endIconMode="password_toggle">
<com.google.android.material.textfield.TextInputEditText style="?attr/ttAuthInputStyle" android:id="@+id/confirmInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:saveEnabled="false" android:importantForAutofill="no" android:singleLine="true" android:imeOptions="actionNext|flagNoPersonalizedLearning" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textview.MaterialTextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:textColor="?attr/colorOnSurface" android:visibility="gone" />
<com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:contentDescription="@string/auth_processing" android:indeterminate="true" android:visibility="gone" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/submit" style="?attr/ttAuthPrimaryStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/confirmCode" style="?attr/ttAuthTonalStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/recovery_confirm_email" android:visibility="visible" />
<com.google.android.material.button.MaterialButton android:id="@+id/retry" style="?attr/ttAuthTonalStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/recovery_retry" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/recovery_back" android:visibility="visible" />
</LinearLayout></androidx.core.widget.NestedScrollView></FrameLayout>

