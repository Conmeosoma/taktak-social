<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.TakTak.M3.Camera"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="wrap_content" app:cardCornerRadius="28dp" app:cardElevation="0dp"
        app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.camera.view.PreviewView android:id="@+id/cameraPreview" android:layout_width="0dp" android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1" android:keepScreenOn="true" android:contentDescription="@string/moment_camera_preview" />
            <ImageView android:id="@+id/serverImage" android:layout_width="0dp" android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/cameraPreview" app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
                app:layout_constraintStart_toStartOf="@id/cameraPreview" app:layout_constraintEnd_toEndOf="@id/cameraPreview"
                android:scaleType="fitCenter" android:visibility="gone" android:saveEnabled="false"
                android:contentDescription="@string/moment_server_image" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/cameraPlaceholder"
                android:layout_width="0dp" android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center" android:padding="@dimen/m3_space_24" android:background="?attr/colorSecondaryContainer"
                android:text="@string/camera_permission_hint" android:textColor="?attr/colorOnSecondaryContainer"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton android:id="@+id/switchCameraButton"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="0dp" android:enabled="false"
            android:text="@string/camera_switch" />
        <com.google.android.material.button.MaterialButton android:id="@+id/flashButton"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minHeight="48dp" android:minWidth="0dp"
            android:enabled="false" android:text="@string/camera_flash_off" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/m3_space_12">
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/momentProgress"
            style="@style/Widget.Material3Expressive.LinearProgressIndicator"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
            android:indeterminate="true" android:visibility="invisible" />
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/cameraPermissionButton"
        style="@style/Widget.TakTakM3.Button" android:layout_marginBottom="@dimen/m3_space_12"
        android:text="@string/moment_camera_permission" />
    <com.google.android.material.button.MaterialButton android:id="@+id/captureButton"
        style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
        android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal"
        android:insetTop="0dp" android:insetBottom="0dp"
        android:contentDescription="@string/moment_capture" android:enabled="false"
        app:icon="@drawable/ic_camera_shutter" app:iconSize="32dp" app:iconPadding="0dp"
        app:iconGravity="textStart" app:iconTint="@color/m3_shutter_icon" app:backgroundTint="@color/m3_shutter_background" />
    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/m3_space_8" android:gravity="center" android:text="@string/camera_shutter_label"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/statusCard"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/m3_space_16"
        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSecondaryContainer">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/m3_space_16">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/statusTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSecondaryContainer" android:text="@string/camera_status_ready" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/momentStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/m3_space_8" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSecondaryContainer" android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/momentRetryButton"
        style="@style/Widget.TakTakM3.Button" android:layout_marginTop="@dimen/m3_space_12"
        android:visibility="gone" android:text="@string/session_retry" />
</LinearLayout>
