<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/taktak_space_md"
    android:paddingTop="@dimen/taktak_space_sm"
    android:paddingBottom="@dimen/taktak_space_lg">

    <!-- Square 1:1 Camera Viewport -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/taktakColorSurface"
        app:cardCornerRadius="@dimen/taktak_radius_card"
        app:cardElevation="0dp"
        app:strokeColor="?attr/taktakColorBorder"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/moment_camera_preview"
                android:keepScreenOn="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/cameraPlaceholder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="?attr/taktakColorSurfaceVariant"
                android:gravity="center"
                android:padding="@dimen/taktak_space_xl"
                android:text="@string/camera_permission_hint"
                android:textAppearance="@style/TextAppearance.Taktak.Body"
                android:textColor="?attr/taktakColorTextSecondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Dual Camera PiP Inset Window -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cameraPipContainer"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_margin="16dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/black"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="@android:color/white"
                app:strokeWidth="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/cameraPipPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/cameraPipImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/camera_dual_pip_label" />

                    <TextView
                        android:id="@+id/cameraPipLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/login_notice"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="@string/camera_dual_swap"
                        android:textColor="@android:color/white"
                        android:textSize="9sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Camera Control Bar: Switch & Flash -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taktak_space_md"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchCameraButton"
            style="@style/Widget.Taktak.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="@dimen/taktak_btn_height_medium"
            android:text="@string/camera_switch"
            android:textAppearance="@style/TextAppearance.Taktak.Caption"
            app:icon="@drawable/ic_premium_switch"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="?attr/taktakColorTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flashButton"
            style="@style/Widget.Taktak.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/taktak_space_sm"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="@dimen/taktak_btn_height_medium"
            android:text="@string/camera_flash_off"
            android:textAppearance="@style/TextAppearance.Taktak.Caption"
            app:icon="@drawable/ic_premium_flash"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="?attr/taktakColorTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dualModeButton"
            style="@style/Widget.Taktak.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/taktak_space_sm"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="@dimen/taktak_btn_height_medium"
            android:text="@string/camera_mode_single"
            android:textAppearance="@style/TextAppearance.Taktak.Caption"
            app:icon="@drawable/ic_dual_cam"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="?attr/taktakColorTextPrimary" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/taktak_space_sm"
        android:layout_marginTop="@dimen/taktak_space_xs">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/momentProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="?attr/taktakColorBrandPrimary"
            app:trackColor="?attr/taktakColorBorder" />
    </FrameLayout>

    <!-- Permission Button (nếu chưa cấp quyền) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cameraPermissionButton"
        style="@style/Widget.Taktak.Button.Primary"
        android:layout_marginBottom="@dimen/taktak_space_md"
        android:text="@string/moment_camera_permission"     android:minHeight="@dimen/taktak_touch_target_min" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLiveAudioToggle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/taktak_space_xs"
        android:paddingHorizontal="10dp"
        android:text="@string/camera_live_audio_off"
        android:textSize="11sp"
        android:layout_gravity="center_horizontal"
        app:cornerRadius="18dp" />


    <!-- Shutter Button 80dp viền kép tròn -->
    <com.taktak.app.ui.camera.ShutterButton
        android:id="@+id/captureButton"
        android:layout_width="@dimen/taktak_shutter_outer"
        android:layout_height="@dimen/taktak_shutter_outer"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/taktak_space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/camera_shutter_label"
        android:enabled="false"
        android:scaleType="fitCenter"
        android:src="@drawable/taktak_shutter_ring" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taktak_space_xs"
        android:gravity="center"
        android:text="@string/camera_shutter_label"
        android:textAppearance="@style/TextAppearance.Taktak.Caption"
        android:textColor="?attr/taktakColorTextMuted" />

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taktak_space_md"
        app:cardBackgroundColor="?attr/taktakColorSurface"
        app:cardCornerRadius="@dimen/taktak_radius_card"
        app:cardElevation="0dp"
        app:strokeColor="?attr/taktakColorBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/taktak_space_md">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/taktak_space_sm"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_m3_lock"
                app:tint="?attr/taktakColorBrandPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_status_ready"
                    android:textAppearance="@style/TextAppearance.Taktak.SectionTitle"
                    android:textColor="?attr/taktakColorTextPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/momentStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_xxs"
                    android:accessibilityLiveRegion="polite"
                    android:saveEnabled="false"
                    android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                    android:textColor="?attr/taktakColorTextSecondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
