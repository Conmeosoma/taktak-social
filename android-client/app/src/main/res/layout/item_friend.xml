<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingVertical="10dp" android:saveEnabled="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/friendAvatar" android:layout_width="48dp" android:layout_height="48dp"
            android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/friendName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:saveEnabled="false" />
            <TextView android:id="@+id/friendUsername" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TakTak.Camera.Body" android:saveEnabled="false" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/friendPrimary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/friendSecondary"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/friends_reject" />
        <com.google.android.material.button.MaterialButton android:id="@+id/friendOptions"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/friends_options_short" />
    </LinearLayout>
</LinearLayout>
