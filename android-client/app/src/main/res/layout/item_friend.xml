<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/taktak_space_sm"
    android:saveEnabled="false"
    app:cardBackgroundColor="?attr/taktakColorSurface"
    app:cardCornerRadius="@dimen/taktak_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="?attr/taktakColorBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taktak_space_md">

        <!-- Friend Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/friendAvatar"
                android:layout_width="@dimen/taktak_avatar_list"
                android:layout_height="@dimen/taktak_avatar_list"
                android:contentDescription="@null"
                android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/friend_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/taktak_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/friendName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Taktak.SectionTitle"
                        android:textColor="?attr/taktakColorTextPrimary" />

                    <TextView
                        android:id="@+id/friendStreakBadge"
                        android:maxWidth="@dimen/taktak_touch_target_min"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/taktak_badge_unread"
                        android:backgroundTint="?attr/taktakColorSurfaceVariant"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:saveEnabled="false"
                        android:text="@string/ui_streak_preview"
                        android:textColor="?attr/taktakColorBrandPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/friendGroupBadge"
                        android:maxWidth="@dimen/taktak_touch_target_min"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/taktak_space_xxs"
                        android:background="@drawable/taktak_badge_unread"
                        android:backgroundTint="?attr/taktakColorSurfaceVariant"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:saveEnabled="false"
                        android:text="@string/ui_close_friends_badge"
                        android:textColor="?attr/taktakColorBrandPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/friendUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:saveEnabled="false"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                    android:textColor="?attr/taktakColorTextMuted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taktak_space_sm"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/friendPrimary"
                style="@style/Widget.Taktak.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/taktak_btn_height_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/friendSecondary"
                style="@style/Widget.Taktak.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taktak_space_xs"
                android:minHeight="@dimen/taktak_btn_height_medium"
                android:text="@string/friends_reject" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/friendOptions"
                style="@style/Widget.Taktak.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/taktak_btn_height_small"
                android:text="@string/friends_options_short" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
