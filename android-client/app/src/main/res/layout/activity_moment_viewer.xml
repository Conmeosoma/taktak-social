<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/taktakColorSurface"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/viewerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/taktak_space_md"
        android:paddingVertical="@dimen/taktak_space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewerCloseButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/taktak_touch_target_min"
            android:layout_height="@dimen/taktak_touch_target_min"
            android:contentDescription="@string/history_viewer_close"
            app:icon="@drawable/ic_close"
            app:iconTint="?attr/taktakColorTextPrimary"     android:minHeight="@dimen/taktak_touch_target_min" />

        <ImageView
            android:id="@+id/viewerSenderAvatar"
            android:layout_width="@dimen/taktak_avatar_list"
            android:layout_height="@dimen/taktak_avatar_list"
            android:layout_marginStart="@dimen/taktak_space_xs"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/taktak_space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/viewerSenderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Taktak.SectionTitle"
                android:textColor="?attr/taktakColorTextPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/viewerSenderUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                    android:textColor="?attr/taktakColorTextMuted" />

                <TextView
                    android:id="@+id/viewerTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/taktak_space_xs"
                    android:textAppearance="@style/TextAppearance.Taktak.Caption"
                    android:textColor="?attr/taktakColorTextMuted" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewerSaveButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/taktak_touch_target_min"
            android:layout_height="@dimen/taktak_touch_target_min"
            android:contentDescription="@string/history_viewer_save"
            app:icon="@drawable/ic_download"
            app:iconTint="?attr/taktakColorBrandPrimary"     android:minHeight="@dimen/taktak_touch_target_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewerDeleteButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/taktak_touch_target_min"
            android:layout_height="@dimen/taktak_touch_target_min"
            android:contentDescription="@string/history_viewer_delete"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/taktak_status_error"     android:minHeight="@dimen/taktak_touch_target_min" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/viewerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:saveEnabled="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/taktak_space_md"
            android:paddingBottom="@dimen/taktak_space_xl">

            <LinearLayout
                android:id="@+id/viewerContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="480dp">

                <!-- Center Photo Frame (1:1 Ratio) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/viewerImageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/taktakColorSurface"
                    app:cardCornerRadius="@dimen/taktak_radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/taktakColorBorder"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/viewerImage"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="@string/history_viewer_image"
                            android:scaleType="fitCenter"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <VideoView
                            android:id="@+id/viewerVideo"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/viewerLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:background="@drawable/login_notice"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/viewer_live_badge"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/viewerProgress"
                            style="@style/Widget.Material3Expressive.CircularProgressIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/history_image_loading"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="?attr/taktakColorBrandPrimary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/viewerErrorView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/taktak_space_md"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/viewerErrorText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/history_image_error"
                                android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                                android:textColor="@color/taktak_status_error" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/viewerRetryButton"
                                style="@style/Widget.Taktak.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/taktak_space_sm"
                                android:text="@string/history_retry"     android:minHeight="@dimen/taktak_touch_target_min" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Caption Container -->
                <LinearLayout
                    android:id="@+id/viewerBottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taktak_space_md"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/viewerCaptionCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/taktakColorSurface"
                        app:cardCornerRadius="@dimen/taktak_radius_btn"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/taktakColorBorder"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/viewerCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/taktak_space_md"
                            android:paddingVertical="@dimen/taktak_space_sm"
                            android:textAppearance="@style/TextAppearance.Taktak.Body"
                            android:textColor="?attr/taktakColorTextPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Photo Poll Interactive Section -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/viewerPollCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/taktak_space_sm"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/taktakColorSurface"
                        app:cardCornerRadius="@dimen/taktak_radius_md"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/taktakColorBorder"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/taktak_space_md">

                            <TextView
                                android:id="@+id/viewerPollQuestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Taktak.Body"
                                android:textStyle="bold"
                                android:textColor="?attr/taktakColorTextPrimary" />

                            <!-- Option A -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/taktak_space_sm"
                                android:orientation="vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnVoteA"
                                    style="@style/Widget.Taktak.Button.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="44dp" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/pollProgressA"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone"
                                    app:indicatorColor="?attr/taktakColorBrandPrimary"
                                    app:trackColor="?attr/taktakColorBorder" />
                            </LinearLayout>

                            <!-- Option B -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/taktak_space_xs"
                                android:orientation="vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnVoteB"
                                    style="@style/Widget.Taktak.Button.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="44dp" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/pollProgressB"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone"
                                    app:indicatorColor="?attr/taktakColorBrandSecondary"
                                    app:trackColor="?attr/taktakColorBorder" />
                            </LinearLayout>

                            <!-- Status & Close Action -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/taktak_space_sm"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/viewerPollStatus"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textAppearance="@style/TextAppearance.Taktak.Caption"
                                    android:textColor="?attr/taktakColorTextMuted" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPollClose"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="0dp"
                                    android:minHeight="36dp"
                                    android:text="Đóng bình chọn"
                                    android:textSize="12sp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/viewerReplyPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/taktak_space_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/moment_reply_private"
                            android:textAppearance="@style/TextAppearance.Taktak.Secondary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/viewerReplyLayout"
                            style="@style/Widget.Taktak.TextInputLayout"
                            android:layout_marginTop="@dimen/taktak_space_sm">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/viewerReplyInput"
                                style="@style/Widget.Taktak.TextInputEditText"
                                android:hint="@string/moment_reply_hint"
                                android:inputType="textCapSentences|textMultiLine"
                                android:singleLine="false"
                                android:maxLines="4"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:imeOptions="flagNoPersonalizedLearning" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/viewerReplyStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.Taktak.Secondary"
                            android:visibility="gone" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/viewerReplyProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/moment_reply_sending"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/viewerReplySend"
                            style="@style/Widget.Taktak.Button.Primary"
                            android:layout_marginTop="@dimen/taktak_space_sm"
                            android:text="@string/moment_reply_send" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/viewerReplyDiscard"
                            style="@style/Widget.Taktak.Button.Ghost"
                            android:layout_width="match_parent"
                            android:text="@string/chat_edit_retry"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
