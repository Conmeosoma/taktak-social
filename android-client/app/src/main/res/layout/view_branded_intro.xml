<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/introRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/splash_background" android:clickable="true" android:focusable="true">
    <TextureView android:id="@+id/introVideo" android:layout_width="match_parent"
        android:layout_height="match_parent" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:gravity="end|center_vertical" android:orientation="horizontal"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/introSound"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/intro_sound_on" />
        <com.google.android.material.button.MaterialButton android:id="@+id/introSkip"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="12dp"
            android:text="@string/intro_skip" />
    </LinearLayout>
</FrameLayout>
