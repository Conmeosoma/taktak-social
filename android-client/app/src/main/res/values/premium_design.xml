<resources>
    <color name="premium_bg">#FFF8F7</color>
    <color name="premium_surface">#FFF0F1</color>
    <color name="premium_ink">#30252F</color>
    <color name="premium_muted">#6D5B6B</color>
    <color name="premium_pink">#A23260</color>
    <color name="premium_lavender">#6F4D96</color>
    <color name="premium_outline">#BDA6BD</color>
    <color name="premium_tonal">#EADBF5</color>
    <color name="premium_nav">#F7EDF5</color>
    <string name="premium_friends_detail">Tìm kiếm và kết nối với những người thân thiết của bạn.</string>
    <string name="premium_profile_detail">Quản lý thông tin cá nhân\nvà cài đặt tài khoản.</string>
    <style name="Theme.TakTak.Premium" parent="Theme.TakTak.M3">
        <item name="android:windowBackground">@color/premium_bg</item>
        <item name="android:colorBackground">@color/premium_bg</item>
        <item name="colorSurface">@color/premium_bg</item>
        <item name="colorSurfaceContainerLowest">@color/premium_bg</item>
        <item name="colorSurfaceContainerLow">@color/premium_surface</item>
        <item name="colorSurfaceContainer">@color/premium_surface</item>
        <item name="colorSurfaceContainerHigh">@color/premium_surface</item>
        <item name="colorSurfaceContainerHighest">@color/premium_tonal</item>
        <item name="colorOnSurface">@color/premium_ink</item>
        <item name="colorOnSurfaceVariant">@color/premium_muted</item>
        <item name="colorPrimary">@color/premium_pink</item>
        <item name="colorSecondary">@color/premium_lavender</item>
        <item name="colorSecondaryContainer">@color/premium_tonal</item>
        <item name="colorOnSecondaryContainer">@color/premium_ink</item>
        <item name="colorOutline">@color/premium_outline</item>
        <item name="colorOutlineVariant">@color/premium_outline</item>
    </style>
    <style name="TextAppearance.TakTakPremium.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">36sp</item><item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/premium_ink</item>
    </style>
    <style name="Widget.TakTakPremium.Field" parent="Widget.TakTakM3.Field">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeColor">@color/premium_field_stroke</item>
        <item name="boxCornerRadiusTopStart">24dp</item><item name="boxCornerRadiusTopEnd">24dp</item>
        <item name="boxCornerRadiusBottomStart">24dp</item><item name="boxCornerRadiusBottomEnd">24dp</item>
        <item name="startIconTint">@color/premium_pink</item><item name="endIconTint">@color/premium_muted</item>
        <item name="helperTextTextColor">@color/premium_muted</item><item name="hintTextColor">@color/premium_muted</item>
    </style>
    <style name="Widget.TakTakPremium.Primary" parent="Widget.TakTakLogin.GradientButton">
        <item name="android:background">@drawable/premium_primary</item>
    </style>
    <style name="Widget.TakTakPremium.Outline" parent="Widget.TakTakLogin.GradientButton">
        <item name="android:background">@drawable/premium_outline_button</item>
        <item name="android:textColor">@color/premium_pink</item>
    </style>
    <style name="Widget.TakTakPremium.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:minHeight">48dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/premium_tonal</item><item name="android:textColor">@color/premium_ink</item>
        <item name="iconTint">@color/premium_ink</item>
    </style>
    <style name="Widget.TakTakPremium.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/premium_tonal</item><item name="android:width">72dp</item><item name="android:height">38dp</item>
    </style>
    <style name="TextAppearance.TakTakPremium.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="ShapeAppearanceOverlay.TakTakPremium.Avatar" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
