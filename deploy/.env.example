# ==============================================================================
# Taktak Production Environment Configuration Template
# Sao chép file này thành .env trên VPS tại /var/taktak/.env và cấp quyền chmod 600
# KHÔNG commit file .env thật chứa secrets vào Git!
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL (chỉ lắng nghe localhost/private network)
DB_URL=jdbc:postgresql://127.0.0.1:5432/taktak
DB_USERNAME=taktak
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# 2. Cổng và địa chỉ lắng nghe máy chủ Spring Boot (chỉ bind localhost, để Nginx proxy)
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 3. Secret JWT (bắt buộc tối thiểu 256-bit, tạo bằng lệnh: openssl rand -base64 32)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# 4. Thư mục lưu trữ ảnh riêng tư (bắt buộc nằm ngoài web root công khai của Nginx)
IMAGE_STORAGE_ROOT=/var/taktak/private-images

# 5. Firebase Cloud Messaging (Admin SDK private service account credentials)
FCM_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/var/taktak/firebase-admin.json

# 6. Email xác minh/khôi phục: SMTP STARTTLS bắt buộc, không dùng mật khẩu Gmail thường.
# Gmail cần bật xác minh 2 bước và tạo App Password; chỉ điền trong file .env local/VPS.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SENDER_EMAIL
MAIL_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
MAIL_FROM=CHANGE_ME_SENDER_EMAIL

# AI backend chỉ bật khi được duyệt rollout; credential file không đưa vào Git/image.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CREDENTIALS_FILE=/var/taktak/secrets/gemini.json
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENT=2
GEMINI_USER_RPM=5
GEMINI_APP_RPM=20
GEMINI_APP_DAILY_REQUESTS=100
GEMINI_CONTEXT_CHARS=16000
