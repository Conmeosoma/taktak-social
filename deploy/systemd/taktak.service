[Unit]
Description=Taktak Social Backend Service
After=syslog.target network.target postgresql.service
Requires=postgresql.service
ConditionPathExists=!/var/taktak/.restore-quarantine

[Service]
Type=simple
User=taktak
Group=taktak
WorkingDirectory=/var/taktak

# Đọc cấu hình bí mật từ file môi trường local
EnvironmentFile=/var/taktak/.env
ExecStartPre=/usr/bin/test ! -e /var/taktak/.restore-quarantine
ExecStart=/usr/bin/java -XX:+UseSerialGC -Xms128m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -Xss512k -Dspring.profiles.active=prod -jar /var/taktak/taktak-server.jar

# Giới hạn tài nguyên tránh tràn RAM và nghẽn CPU (1 vCPU, 1 GB RAM)
CPUQuota=90%
MemoryHigh=380M
MemoryMax=450M

# Tự động khởi động lại khi gặp sự cố
Restart=always
RestartSec=10

# Tăng cường bảo mật quy trình (Systemd Hardening)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/taktak/private-images /var/log/taktak
CapabilityBoundingSet=
AmbientCapabilities=

# Logging qua systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=taktak-server

[Install]
WantedBy=multi-user.target
