# Mẫu tên biến; không chứa credential thật. Spring Boot không tự nạp .env.
DB_URL=jdbc:postgresql://127.0.0.1:5432/taktak
DB_USERNAME=taktak_dev
DB_PASSWORD=<set-locally>
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
IMAGE_STORAGE_ROOT=./.local/private-images
# Chỉ chuẩn bị ở bước auth/FCM tương ứng; chưa dùng trong 1A.
JWT_ACCESS_SECRET=<generate-locally-before-auth>
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
GOOGLE_APPLICATION_CREDENTIALS=<local-server-credential-path-at-step-6>
